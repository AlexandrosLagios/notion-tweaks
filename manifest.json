{
  "manifest_version": 3,
  "name": "Enhanced Notion",
  "version": "2.1.0",
  "description": "Group your Notion inbox, mark what needs action, archive with undo, and schedule comments. Not affiliated with Notion.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "scripting", "sidePanel", "alarms"],
  "host_permissions": ["https://app.notion.com/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "Open the inbox" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    { "matches": ["https://app.notion.com/*"], "js": ["src/content-main.js"], "world": "MAIN" },
    { "matches": ["https://app.notion.com/*"], "js": ["src/content.js"] }
  ],
  "web_accessible_resources": [{ "resources": ["src/picker.js", "src/schedule.js"], "matches": ["https://app.notion.com/*"] }]
}
